# MongoDB connection string
DB_URI=
# SMTP account used by nodemailer + admin notification address
AUTH_SUPERADMIN_EMAIL=
AUTH_SUPERADMIN_PASS=
JWT_ADMIN_SECRET=
JWT_SUPER_ADMIN_SECRET=
RIB=
# Vercel Blob (image uploads). Auto-added by Vercel when you connect a Blob store
# to the project (Storage tab); for local dev copy it from the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=
# THE single place to control the site's public URL (meta tags, canonical
# links, footer/legal links, sitemap.xml/robots.txt, and emailed
# activation/reset/notification links -- see utils/config/site.js).
# Defaults to https://cyber-mall.vercel.app when unset. Change this ONE value
# in Vercel (Settings -> Environment Variables) and redeploy whenever the
# domain changes -- e.g. set it to https://cyber-mall.tn once that domain is
# purchased and attached to the project. No code changes needed.
NEXT_PUBLIC_SITE_URL=
# JWT secrets: use two DIFFERENT random values of at least 32 bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Admin AI assistant (pages/admin/ai-assistant.js). Get a key at
# https://console.anthropic.com/ -- without it the assistant page shows a
# "not configured" notice instead of erroring.
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5. Set to e.g. claude-sonnet-5 for a
# cheaper model -- one value, no code changes.
ANTHROPIC_MODEL=
